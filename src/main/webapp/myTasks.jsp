        <a href="<%= ctx %>/payroll/processing" class="nav-accordion-item ">
          <div class="item-icon-box">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="4" y="2" width="16" height="20" rx="2"></rect><line x1="8" y1="6" x2="16" y2="6"></line><line x1="16" y1="14" x2="16" y2="18"></line><path d="M16 10h.01"></path><path d="M12 10h.01"></path><path d="M8 10h.01"></path><path d="M12 14h.01"></path><path d="M8 14h.01"></path><path d="M12 18h.01"></path><path d="M8 18h.01"></path></svg>
          </div>
          <div class="item-text">
            <span class="item-name">Process Payroll</span>
            <span class="item-desc">Monthly calculations</span>
          </div>
        </a>
        <a href="<%= ctx %>/payroll/history" class="nav-accordion-item ">
          <div class="item-icon-box">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          </div>
          <div class="item-text">
            <span class="item-name">Payroll History &amp; Slips</span>
            <span class="item-desc">Review records & slips</span>
          </div>
        </a>
      </div>
    </div>

    <!-- Performance & Ratings -->
    <div class="nav-group" style="border-top: 1px solid var(--slate-200); padding-top: 14px; margin-top: 6px; padding-bottom: 24px;">
      <span class="nav-label">Ratings &amp; Performance</span>
      <div class="tabs-nav">
        <a href="<%= ctx %>/employeePerformance" class="btn-sidebar-link ratings-link ">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          Employee Ratings &amp; Performance
        </a>
      </div>
    </div>
    <% } %>
  </aside>

  <!-- Workspace Area -->
  <div class="workspace">
    <header class="topbar">
      <h1 class="page-title">
        My Assigned Tasks
      </h1>
      <div class="user-ctrls">
        <div class="user-badge">
          <div class="user-avatar"><%= userInitial %></div>
          <span class="user-info-text"><%= userName %><%= !empIdDisplay.isEmpty() ? " (" + empIdDisplay + ")" : "" %></span>
        </div>
        <a class="btn-signout" href="logout">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Logout
        </a>
      </div>
    </header>

    <div class="content-wrap">
      <div class="page-header">
        <p class="page-subtitle">Track your deliverables, record task progress updates, and mark completed milestones.</p>
      </div>

      <!-- Quick Stats for Employee -->
      <% if (stats != null) { %>
        <div class="kpi-row">
          <div class="kpi-card">
            <div class="kpi-label">Total Assigned</div>
            <div class="kpi-num"><%= stats.getOrDefault("total", 0) %></div>
          </div>
          <div class="kpi-card">
            <div class="kpi-label">Pending / New</div>
            <div class="kpi-num" style="color:#64748b;"><%= stats.getOrDefault("assigned", 0) %></div>
          </div>
          <div class="kpi-card">
            <div class="kpi-label">In Progress</div>
            <div class="kpi-num" style="color:#0284c7;"><%= stats.getOrDefault("inProgress", 0) %></div>
          </div>
          <div class="kpi-card">
            <div class="kpi-label">Completed</div>
            <div class="kpi-num" style="color:#059669;"><%= stats.getOrDefault("completed", 0) %></div>
          </div>
        </div>
      <% } %>

      <!-- Tasks Table -->
      <div class="table-card">
        <% if (tasks == null || tasks.isEmpty()) { %>
          <div class="empty-state">
            <div style="width:54px; height:54px; border-radius:14px; background:#eff6ff; color:#2563eb; display:flex; align-items:center; justify-content:center; margin:0 auto 16px;">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <polyline points="9 11 12 14 22 4"></polyline>
                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
              </svg>
            </div>
            <p style="font-weight:800; font-size:16px; color:var(--slate-800);">No tasks currently assigned</p>
            <p style="font-size:13.5px; color:var(--slate-500); margin-top:4px;">You have no active or pending tasks at this moment.</p>
          </div>
        <% } else { %>
          <div class="table-responsive">
            <table>
              <thead>
                <tr>
                  <th>Task ID</th>
                  <th>Task</th>
                  <th>Priority</th>
                  <th>Status</th>
                  <th>Due Date</th>
                  <th style="text-align:right;">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% for (Task t : tasks) { 
                     String stClass = "badge-" + (t.getStatus() != null ? t.getStatus().toLowerCase() : "assigned");
                     String prClass = "priority-" + (t.getPriority() != null ? t.getPriority().toLowerCase() : "medium");
                %>
                  <tr>
                    <td><span class="task-id-badge"><%= t.getFormattedId() %></span></td>
                    <td>
                      <div class="task-title"><%= t.getTaskTitle() %></div>
                      <div style="display:flex; align-items:center; gap:8px; margin-top:5px; flex-wrap:wrap;">
                        <span style="font-size:12px; color:var(--slate-500);"><%= t.getDepartment() != null ? t.getDepartment() : "General" %></span>
                        <% if (t.hasWorkFile()) { %>
                          <a href="downloadTaskFile?taskId=<%= t.getId() %>&type=work" class="file-tag file-tag-work">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                            Work File
                          </a>
                        <% } %>
                        <% if (t.hasWorkProofFile()) { %>
                          <span class="file-tag file-tag-proof">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            Proof Attached
                          </span>
                        <% } %>
                        <% if (t.hasFeedback()) { %>
                          <span class="file-tag file-tag-feedback">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                            Feedback Received
                          </span>
                        <% } %>
                      </div>
                    </td>
                    <td><span class="priority-pill <%= prClass %>"><%= t.getPriority() %></span></td>
                    <td><span class="badge <%= stClass %>"><%= t.getStatus() %></span></td>
                    <td><span style="font-size:13px; font-weight:600;"><%= t.getFormattedDueDate() %></span></td>
                    <td style="text-align:right;">
                      <div class="action-group" style="justify-content:flex-end;">
                        <a href="viewTask?id=<%= t.getId() %>" class="action-btn action-view">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                          View
                        </a>
                        <a href="updateTaskStatus?id=<%= t.getId() %>" class="action-btn action-status">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M11 4H4a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                          Update Status
                        </a>
                      </div>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<script>
function toggleNavAccordion(id) {
  var b = document.getElementById(id + '-body');
  var h = document.getElementById(id + '-header');
  if (b && h) {
    b.classList.toggle('open');
    h.classList.toggle('open');
  }
}
</script>

</body>
</html>
